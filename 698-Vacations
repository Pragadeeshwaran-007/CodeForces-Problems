#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    // dp[i][0] -> rest
    // dp[i][1] -> contest
    // dp[i][2] -> sport
    vector<vector<int>> dp(n, vector<int>(3));

    // Day 0
    dp[0][0] = 1; // Rest
    dp[0][1] = (a[0] == 1 || a[0] == 3) ? 0 : 1;
    dp[0][2] = (a[0] == 2 || a[0] == 3) ? 0 : 1;

    for (int i = 1; i < n; i++) {

        // Rest today
        // We can come from any activity yesterday
        dp[i][0] = min({
            dp[i-1][0],
            dp[i-1][1],
            dp[i-1][2]
        }) + 1;

        // Contest today
        if (a[i] == 1 || a[i] == 3) {
            // Yesterday cannot also be contest
            dp[i][1] = min(
                dp[i-1][0],
                dp[i-1][2]
            );
        } else {
            dp[i][1] = 1e9;
        }

        // Sport today
        if (a[i] == 2 || a[i] == 3) {
            // Yesterday cannot also be sport
            dp[i][2] = min(
                dp[i-1][0],
                dp[i-1][1]
            );
        } else {
            dp[i][2] = 1e9;
        }
    }

    cout << min({
        dp[n-1][0],
        dp[n-1][1],
        dp[n-1][2]
    }) << endl;

    return 0;
}
